#!/home/laob/SARndbox-rosto/venv/bin/python
"""Modo FOTO da caixa de areia: projeta uma imagem da pasta Areia que se deforma com a areia.

  areia-foto                 escolhe a imagem num menu (Enter = a última usada)
  areia-foto 3               a imagem número 3 da lista
  areia-foto gato            a imagem da pasta cujo nome contém "gato"
  areia-foto ~/x/foto.jpg    qualquer arquivo (é copiado para a pasta Areia)
  areia-foto lista           só mostra a lista
  areia-foto pasta           abre a pasta Areia no gerenciador de arquivos
  areia-foto girar           gira 90° (se aparecer de lado para quem olha a caixa)
  areia-foto espelhar        espelha
  areia-foto camera          tira a foto pela câmera do laboratório (precisa do Willbert)
Opções depois da imagem: --com-fundo (não recorta) / --sem-fundo (recorta a pessoa mesmo sem rosto).
Para voltar à topografia: areia-topografia
"""
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time

D = "/home/laob/SARndbox-rosto"
PY = os.path.join(D, "venv", "bin", "python")
FOTOS = os.path.join(D, "fotos")
CACHE = os.path.join(FOTOS, "cache")
EST = os.path.join(D, "estado.json")
SANDBOX = os.path.join(D, "sandbox.sh")
EXT = (".jpg", ".jpeg", ".png", ".webp", ".bmp", ".tif", ".tiff")
AJUSTE = {"zoom": 0.03, "desloc": 0.0, "mistura": 0.0, "sombra": 1.0}


def pasta():
    try:
        img = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True, text=True).stdout.strip()
    except OSError:
        img = ""
    p = os.path.join(img if img and img != os.path.expanduser("~") else os.path.expanduser("~/Pictures"), "Areia")
    os.makedirs(p, exist_ok=True)
    return p


def estado():
    try:
        e = json.load(open(EST))
    except (OSError, ValueError):
        e = {}
    e.setdefault("giro", 0); e.setdefault("espelho", False)
    e["ajuste"] = {**AJUSTE, **e.get("ajuste", {})}
    return e


def salva(e):
    json.dump(e, open(EST + ".tmp", "w")); os.replace(EST + ".tmp", EST)


def imagens():
    p = pasta()
    nomes = [n for n in os.listdir(p) if n.lower().endswith(EXT) and not n.startswith(".")]
    return [os.path.join(p, n) for n in sorted(nomes, key=str.casefold)]


def mostra_lista(lista, ultima=None):
    print(f"Imagens em {pasta()}:")
    if not lista:
        print("  (vazia: coloque fotos .jpg ou .png nessa pasta)")
    for i, c in enumerate(lista, 1):
        print(f"  {i:2d}  {os.path.basename(c)}" + ("   <- última" if c == ultima else ""))


def escolhe(arg, e):
    """Caminho da imagem pedida (número, parte do nome, arquivo) ou do menu."""
    lista = imagens()
    if arg is None:
        ultima = e.get("imagem")
        if not sys.stdin.isatty():  # sem terminal (ex.: por SSH sem -t): a última usada
            if ultima and os.path.exists(ultima):
                return ultima
            mostra_lista(lista); sys.exit("Diga qual: areia-foto <número>")
        mostra_lista(lista, ultima)
        if not lista:
            sys.exit(1)
        padrao = ultima if ultima in lista else None
        r = input("Número da imagem" + (" (Enter = a última)" if padrao else "") + ": ").strip()
        if not r and padrao:
            return padrao
        arg = r
    if arg.isdigit():
        n = int(arg)
        if 1 <= n <= len(lista):
            return lista[n - 1]
        mostra_lista(lista); sys.exit(f"não há imagem número {n}")
    caminho = os.path.expanduser(arg)
    if os.path.isfile(caminho):
        if not caminho.lower().endswith(EXT):
            sys.exit("formato não suportado (use .jpg, .png, .webp ou .bmp; foto HEIC do iPhone: converta antes)")
        destino = os.path.join(pasta(), os.path.basename(caminho))
        if os.path.abspath(caminho) != os.path.abspath(destino):
            shutil.copy2(caminho, destino)
            print(f"Copiada para a pasta Areia: {os.path.basename(destino)}")
        return destino
    achadas = [c for c in lista if arg.casefold() in os.path.basename(c).casefold()]
    if len(achadas) == 1:
        return achadas[0]
    mostra_lista(achadas or lista)
    sys.exit(f"mais de uma imagem com \"{arg}\": use o número" if achadas else f"nenhuma imagem com \"{arg}\"")


def prepara(img, e, fundo):
    """Recorta/realça (uns 5 s) ou reaproveita o que já foi preparado com os mesmos ajustes."""
    h = hashlib.sha1(open(img, "rb").read())
    h.update(open(os.path.join(D, "rosto.py"), "rb").read())  # mudou o programa: prepara de novo
    h.update(f"{e['giro']}|{e['espelho']}|{fundo}".encode())
    pronto = os.path.join(CACHE, h.hexdigest()[:16])
    if not os.path.exists(os.path.join(pronto, "rosto.dem")):
        print("Preparando a imagem (recorte do fundo, uns 5 s)...")
        args = [PY, os.path.join(D, "rosto.py"), img, "--giro", str(e["giro"]), "--saida", pronto]
        if e["espelho"]:
            args.append("--espelho")
        if fundo:
            args.append(fundo)
        r = subprocess.run(args, capture_output=True, text=True)
        if r.returncode != 0:
            shutil.rmtree(pronto, ignore_errors=True)
            sys.exit("não consegui preparar a imagem: " + (r.stderr.strip().splitlines() or ["?"])[-1])
        for linha in r.stdout.splitlines():
            print("  " + linha.split(" /")[0])
    for n in ("rosto.png", "rosto.dem"):  # o painel do celular usa fotos/rosto.*
        shutil.copy2(os.path.join(pronto, n), os.path.join(FOTOS, n + ".tmp"))
        os.replace(os.path.join(FOTOS, n + ".tmp"), os.path.join(FOTOS, n))
    os.utime(pronto)
    limpa_cache()


def limpa_cache(manter=40):
    if not os.path.isdir(CACHE):
        return
    dirs = sorted((os.path.join(CACHE, d) for d in os.listdir(CACHE)), key=os.path.getmtime, reverse=True)
    for d in dirs[manter:]:
        shutil.rmtree(d, ignore_errors=True)


def projeta(e):
    if subprocess.run([SANDBOX, "rosto"], capture_output=True).returncode != 0:
        sys.exit("o modo foto não abriu; a topografia voltou (veja " + os.path.join(D, "sandbox.log") + ")")
    png = os.path.join(FOTOS, "rosto.png")
    a = e["ajuste"]
    subprocess.run([SANDBOX, "cmd", f"rosto {png} {e['giro']} {int(e['espelho'])}"], capture_output=True)
    subprocess.run([SANDBOX, "cmd", f"rostoAjuste {a['zoom']} {a['desloc']} {a['mistura']} {a['sombra']}"],
                   capture_output=True)
    e["modo"] = "rosto"
    salva(e)


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    opcoes = [a for a in sys.argv[1:] if a.startswith("--")]
    fundo = next((o for o in opcoes if o in ("--com-fundo", "--sem-fundo")), "")
    if any(o in ("-h", "--help") for o in sys.argv[1:]) or args[:1] in (["ajuda"], ["-h"]):
        print(__doc__.strip()); return
    e = estado()
    cmd = args[0] if args else None
    if cmd == "lista":
        mostra_lista(imagens(), e.get("imagem")); return
    if cmd == "pasta":
        subprocess.Popen(["xdg-open", pasta()], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(pasta()); return
    if cmd in ("girar", "espelhar"):
        if cmd == "girar":
            e["giro"] = (int(e["giro"]) + 90) % 360
        else:
            e["espelho"] = not e["espelho"]
        img = e.get("imagem")
        if not img or not os.path.exists(img):
            salva(e); sys.exit("ajuste guardado; escolha uma imagem: areia-foto")
        fundo = e.get("fundo", "")
    elif cmd in ("camera", "câmera"):
        r = subprocess.run(["sudo", "-n", "/usr/local/sbin/willbert-controle", "foto"], capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit("não consegui a foto da câmera (o Willbert está configurado?)")
        img = os.path.join(pasta(), time.strftime("camera-%Y-%m-%d-%H%M%S.jpg"))
        shutil.copy2(os.path.join(FOTOS, "camera.jpg"), img)
    else:
        img = escolhe(cmd, e)
    print(f"Imagem: {os.path.basename(img)}")
    prepara(img, e, fundo)
    e["imagem"], e["fundo"] = img, fundo
    projeta(e)
    print("Modo FOTO no projetor. Outra imagem: areia-foto   Voltar: areia-topografia")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        sys.exit(130)
